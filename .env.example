CONTROL_PLANE_ENVIRONMENT=development
CONTROL_PLANE_DATABASE_URL=postgresql+psycopg://control_plane:control_plane@localhost:55432/control_plane
CONTROL_PLANE_LOG_LEVEL=INFO
CONTROL_PLANE_WORKER_POLL_SECONDS=1.0
CONTROL_PLANE_LEASE_SECONDS=30
# Defaults to one-third of the lease, capped at 10 seconds.
# CONTROL_PLANE_LEASE_HEARTBEAT_SECONDS=10
CONTROL_PLANE_EVIDENCE_WINDOW_SIZE=100
CONTROL_PLANE_HIGH_RISK_MIN_EVIDENCE_SAMPLES=20
# BALANCED, QUALITY, SPEED, or FRUGAL. This never changes provider eligibility.
CONTROL_PLANE_ROUTING_OBJECTIVE=BALANCED
CONTROL_PLANE_WORKTREE_ROOT=.control-plane-worktrees
# CONTROL_PLANE_REPOSITORY_REGISTRY_FILE=repository-registry.json
# Provider integrations remain disabled unless this file is explicitly configured.
# CONTROL_PLANE_PROVIDER_POLICY_FILE=provider-policy.json
# ANTHROPIC_API_KEY=set-outside-source-control
# DEVIN_API_KEY=set-outside-source-control
# GitHub webhook ingestion is disabled by default. Use a high-entropy secret shared only
# with the GitHub App or repository webhook; never commit its value.
# CONTROL_PLANE_GITHUB_WEBHOOK_ENABLED=true
# CONTROL_PLANE_GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
# CONTROL_PLANE_GITHUB_APP_POLICY_FILE=github-app-policy.json
# GITHUB_APP_PRIVATE_KEY=set-multiline-pem-outside-source-control
# Required outside development and test. Keep the real policy ignored and operator-owned.
# CONTROL_PLANE_OIDC_POLICY_FILE=oidc-policy.json
# Operational telemetry is disabled unless separately authenticated.
# CONTROL_PLANE_METRICS_ENABLED=true
# CONTROL_PLANE_METRICS_BEARER_TOKEN=replace-with-a-random-monitoring-token
# CONTROL_PLANE_DASHBOARD_ENABLED=true
# Disabled by default. Generate a random token with at least 32 characters.
# CONTROL_PLANE_WINDSURF_MCP_ENABLED=true
# CONTROL_PLANE_WINDSURF_MCP_BEARER_TOKEN=replace-with-a-random-local-development-token
# CONTROL_PLANE_WINDSURF_MCP_PRINCIPAL_ID=windsurf-cascade
# CONTROL_PLANE_WINDSURF_MCP_HOST=127.0.0.1
# CONTROL_PLANE_WINDSURF_MCP_PORT=8010
