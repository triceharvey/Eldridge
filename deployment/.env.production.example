CONTROL_PLANE_ENVIRONMENT=production
CONTROL_PLANE_DATABASE_URL=postgresql+psycopg://replace-with-hosted-database
CONTROL_PLANE_LOG_LEVEL=INFO
CONTROL_PLANE_WORKER_POLL_SECONDS=1.0
CONTROL_PLANE_LEASE_SECONDS=30
CONTROL_PLANE_WORKTREE_ROOT=/workspaces
CONTROL_PLANE_REPOSITORY_REGISTRY_FILE=/run/control-plane/policies/repository-registry.json
CONTROL_PLANE_PROVIDER_POLICY_FILE=/run/control-plane/policies/provider-policy.json
CONTROL_PLANE_GITHUB_APP_POLICY_FILE=/run/control-plane/policies/github-app-policy.json
CONTROL_PLANE_OIDC_POLICY_FILE=/run/control-plane/policies/oidc-policy.json
CONTROL_PLANE_GITHUB_WEBHOOK_ENABLED=true
CONTROL_PLANE_GITHUB_WEBHOOK_SECRET=replace-through-secret-injection
CONTROL_PLANE_METRICS_ENABLED=true
CONTROL_PLANE_METRICS_BEARER_TOKEN=replace-through-secret-injection
CONTROL_PLANE_DASHBOARD_ENABLED=true

# Build, scan, push, and replace these with immutable registry image digests.
CONTROL_PLANE_API_IMAGE=registry.example.com/control-plane-api@sha256:replace
CONTROL_PLANE_WORKER_IMAGE=registry.example.com/control-plane-worker@sha256:replace
CADDY_IMAGE=caddy:2-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
CONTROL_PLANE_PROJECTS_ROOT=/srv/control-plane/projects
DOCKER_GID=replace-with-container-engine-socket-group-id
CONTROL_PLANE_DOMAIN=control-plane.example.com
ACME_EMAIL=operator@example.com
