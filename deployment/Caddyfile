{
	email {$ACME_EMAIL}
	admin off
}

{$CONTROL_PLANE_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 2MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	reverse_proxy api:8000 {
		health_uri /health/ready
		health_interval 15s
		health_timeout 3s
	}
}
